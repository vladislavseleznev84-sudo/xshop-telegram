# ===== GHOST AI — copy to .env and fill in. NEVER commit .env =====

# Token from @BotFather (enable "Business Mode" for the bot there)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (send /start to the bot while this is 0 to see it)
OWNER_TELEGRAM_ID=0

# Random string, A-Z a-z 0-9 _ - (1..256 chars). Sent by Telegram in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=
# Fernet key (python scripts/gen_secrets.py) — encrypts stored conversations and profiles
ENCRYPTION_KEY=
# Random string for signing admin-panel sessions
SESSION_SECRET=

# Public HTTPS address of this server, no trailing slash (e.g. https://ghost.example.com)
PUBLIC_BASE_URL=
AUTO_SET_WEBHOOK=true

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# docker-compose uses these for the bundled PostgreSQL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ghost:change-me@db:5432/ghost

DEFAULT_RETENTION_DAYS=30
LOG_LEVEL=INFO
DOMAIN=ghost.example.com
